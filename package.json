{
  "name": "fathohm-cli-mirror",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Build tree for the fathohm CLI and VS Code extension. The published package is cli/.",
  "scripts": {
    "cli:build": "esbuild cli/src/index.ts --bundle --platform=node --target=node20 --format=cjs --banner:js='#!/usr/bin/env node' --outfile=cli/dist/fathohm.cjs",
    "build": "npm run cli:build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "extension:build": "esbuild extension/src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=extension/dist/extension.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.110.6",
    "@types/node": "20.19.43",
    "@types/vscode": "1.125.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
