{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli/**/*.ts",
    "extension/**/*.ts",
    "lib/**/*.ts",
    "workers/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cli/dist",
    "extension/dist"
  ]
}
